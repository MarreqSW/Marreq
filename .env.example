# Copy this file to .env and fill in your local values.
# .env is never committed to git.

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection URL used by the application and by Diesel CLI.
# Default matches docker/docker-compose.yml host mapping (5433 -> container 5432).
# For a native Postgres on 5432, override this URL.
DATABASE_URL=postgres://rust:rust@127.0.0.1:5433/marreq

# Rocket session/cookie signing key.
# Required for `cargo run --release` and for the Docker backend image (release build).
# Docker Compose supplies a dev-only default if unset; set your own for shared or prod hosts:
#   openssl rand -base64 32
# ROCKET_SECRET_KEY=

# ── Web UI ────────────────────────────────────────────────────────────────────
# Rocket serves JSON under /api and GET / (service descriptor). The SPA (e.g. Vite or Docker :8080) is the UI.
# Session cookie: use __Host-session + Secure on HTTPS in production.
# MARREQ_SECURE_SESSION_COOKIE=1

# Deployment mode is selected at build time:
# - Default self-hosted Server mode: cargo run -p marreq-server
# - Hosted Cloud mode: cargo run -p marreq-cloud
#
# Cloud mode enables public registration, email verification, and password reset.
# MARREQ_PUBLIC_BASE_URL=https://marreq.example.com
# MARREQ_SITE_ADMIN_EMAIL=admin@example.com
# MARREQ_SITE_ADMIN_BOOTSTRAP_PASSWORD=

# ── Human authentication / SSO ───────────────────────────────────────────────
# Password login is enabled by default in both deployment modes.
# MARREQ_PASSWORD_AUTH_ENABLED=true
#
# marreq-server: one standards-compliant OIDC provider. The callback registered
# at the IdP must be: <MARREQ_PUBLIC_BASE_URL>/api/auth/external/oidc/callback
# MARREQ_OIDC_ENABLED=false
# MARREQ_OIDC_DISPLAY_NAME="Company SSO"
# MARREQ_OIDC_ISSUER=https://sso.example.com/realms/company
# MARREQ_OIDC_CLIENT_ID=marreq
# MARREQ_OIDC_CLIENT_SECRET=
# MARREQ_OIDC_AUTO_REGISTER=false
#
# marreq-cloud: each provider is enabled when both variables are present.
# Callback suffixes are /google/callback, /github/callback and /gitlab/callback.
# MARREQ_GOOGLE_CLIENT_ID=
# MARREQ_GOOGLE_CLIENT_SECRET=
# MARREQ_GITHUB_CLIENT_ID=
# MARREQ_GITHUB_CLIENT_SECRET=
# MARREQ_GITLAB_CLIENT_ID=
# MARREQ_GITLAB_CLIENT_SECRET=

# CORS (dev: Vite on 5173 + Rocket on 8000). Production same-origin via nginx may omit.
# CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:5173
# CORS_ALLOW_CREDENTIALS=true

# CSRF Origin allowlist (unsafe methods). Include the SPA origin (e.g. :8080) when UI and API ports differ.
# Docker Compose passes this through to the backend; the production override requires it explicitly.
# CSRF_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Host port for the loopback-bound SPA frontend. An external TLS reverse proxy
# should forward the public HTTPS origin to this port in production.
# MARREQ_FRONTEND_PORT=8080
# MARREQ_CLOUD_FRONTEND_PORT=8082

# Example production HTTPS settings:
# ROCKET_SECRET_KEY=<output of: openssl rand -base64 32>
# MARREQ_SECURE_SESSION_COOKIE=1
# MARREQ_PUBLIC_BASE_URL=https://marreq.example.com
# CSRF_ALLOWED_ORIGINS=https://marreq.example.com

# ── Semantic search / embeddings ─────────────────────────────────────────────
# Set EMBEDDINGS_ENABLED=false to disable vector search entirely.
# docker/docker-compose.light.yml forces EMBEDDINGS_ENABLED=false and
# RAG_ENABLED=false and does not define or pull the Ollama service/image.
EMBEDDINGS_ENABLED=false
EMBEDDING_PROVIDER=ollama          # ollama | openai
EMBEDDING_MODEL=nomic-embed-text
# Local Ollama default for the full docker/docker-compose.yml stack.
# Docker Compose maps that Ollama service to host :11435 (see docker/README.md).
OLLAMA_URL=http://localhost:11434

# ── Email notifications (SMTP) ────────────────────────────────────────────────
# Set SMTP_HOST to enable email delivery for user notifications.
# Leave unset to disable email (in-app notifications still work; Cloud users cannot receive verification/reset emails).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=marreq@example.com

# ── RAG (retrieval-augmented generation) ─────────────────────────────────────
# Set RAG_ENABLED=false to disable LLM-assisted search.
RAG_ENABLED=false
RAG_MODEL=llama3.2
RAG_MAX_TOKENS=1024
RAG_TOP_K=10
